#!/usr/bin/env python3
"""Open an RDP session against the dockurr/windows container.

Credentials, the host RDP port and everything else come from the compose file,
so there is nothing to keep in sync: change docker-compose.yml and the next
connect follows. ``--wait`` blocks until Windows actually answers the RDP
handshake, which is what makes "start the VM and connect" a single step from a
terminal. The Noctalia service does not use ``--wait`` -- it watches readiness
on its own poll and calls this script once the guest is up.

The password is passed as ``/p:``, so it is visible in the process list.
``/from-stdin`` would avoid that but silently ignores a piped password, and the
compose file it comes from is world-readable anyway, so this trades nothing.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

# The plugin directory is not ours to litter with __pycache__, and it may be
# read-only wherever the plugin source is installed from.
sys.dont_write_bytecode = True

BIN_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_COMPOSE = "~/Windows/docker-compose.yml"
DEFAULT_WAIT = 300
CLIENT = "xfreerdp3"

# RDP carries two scale factors (MS-RDPBCGR 2.2.2.2.1): DESKTOP_SCALE_FACTOR is
# free between 100 and 500, while DEVICE_SCALE_FACTOR may only ever be 100, 140
# or 180. A Wayland fractional scale has to be snapped onto that second set.
DESKTOP_SCALE_MIN = 100
DESKTOP_SCALE_MAX = 500
DEVICE_SCALE_STEPS = (100, 140, 180)

# Host-side defaults. Everything guest-facing is read from the compose file.
BASE_FLAGS = [
    "/dynamic-resolution",
    "/sound:sys:pulse",
    "/microphone:sys:pulse",
    "+clipboard",
    "/cert:ignore",
]

def _load_sibling(name, filename):
    """Import a sibling script that has no .py extension."""
    loader = SourceFileLoader(name, os.path.join(BIN_DIR, filename))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# Compose parsing and the RDP handshake live in windows-status; sharing them
# keeps one implementation of "where does the password come from".
status = _load_sibling("windows_status", "windows-status")


def detect_scale():
    """The focused output's scale as a percentage, or None if unknown.

    Focused rather than primary on purpose: the session opens on whichever
    monitor the panel was clicked on, so that is the one to match.
    """
    try:
        probe = subprocess.run(
            ["niri", "msg", "--json", "focused-output"],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if probe.returncode != 0:
        return None
    try:
        logical = (json.loads(probe.stdout) or {}).get("logical") or {}
    except ValueError:
        return None
    scale = logical.get("scale")
    if not isinstance(scale, (int, float)) or scale <= 0:
        return None
    return int(round(scale * 100))


def scale_flags(setting):
    """Turn a scale setting into xfreerdp3 flags.

    "auto" asks the compositor, "off" disables scaling, anything else is taken
    as a literal percentage. An unscaled display yields no flags at all, which
    keeps the common case byte-identical to not having this feature.
    """
    if setting == "off":
        return []
    percent = detect_scale() if setting == "auto" else None
    if percent is None and setting != "auto":
        try:
            percent = int(float(setting))
        except ValueError:
            percent = None
    if percent is None:
        return []
    desktop = max(DESKTOP_SCALE_MIN, min(DESKTOP_SCALE_MAX, percent))
    device = min(DEVICE_SCALE_STEPS, key=lambda step: abs(step - desktop))
    if desktop == 100 and device == 100:
        return []
    return ["/scale-desktop:%d" % desktop, "/scale-device:%d" % device]


def build_argv(compose_path, extra, scale="auto"):
    env, ports = status.read_compose(compose_path)
    username = str(env.get("USERNAME") or "").strip()
    password = str(env.get("PASSWORD") or "").strip()
    port = ports.get(3389, 3389)

    argv = [CLIENT, "/v:127.0.0.1:%d" % port]
    if username:
        argv.append("/u:%s" % username)
    if password:
        argv.append("/p:%s" % password)
    argv.extend(BASE_FLAGS)
    argv.extend(scale_flags(scale))
    argv.extend(extra)
    return argv, port


def wait_for_rdp(port, deadline):
    while time.monotonic() < deadline:
        if status.rdp_ready(port):
            return True
        time.sleep(2)
    return status.rdp_ready(port)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compose", default=DEFAULT_COMPOSE, help="compose file to read")
    parser.add_argument(
        "--wait",
        nargs="?",
        type=int,
        const=DEFAULT_WAIT,
        default=0,
        metavar="SECONDS",
        help="block until Windows answers RDP (default %d s)" % DEFAULT_WAIT,
    )
    parser.add_argument(
        "--scale",
        default="auto",
        metavar="auto|off|PERCENT",
        help="match the focused monitor's scale (default), disable it, or force a percentage",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the xfreerdp3 command line instead of running it",
    )
    parser.add_argument(
        "extra", nargs=argparse.REMAINDER, help="further arguments passed to " + CLIENT
    )
    args = parser.parse_args()

    extra = args.extra[1:] if args.extra[:1] == ["--"] else args.extra
    compose_path = os.path.expanduser(args.compose)

    try:
        argv, port = build_argv(compose_path, extra, args.scale)
    except FileNotFoundError:
        print("windows-rdp: no compose file at %s" % compose_path, file=sys.stderr)
        return 1
    except OSError as error:
        print("windows-rdp: cannot read %s: %s" % (compose_path, error), file=sys.stderr)
        return 1

    if args.dry_run:
        print(" ".join(argv))
        return 0

    if args.wait and not wait_for_rdp(port, time.monotonic() + args.wait):
        print("windows-rdp: no RDP answer on port %d after %d s" % (port, args.wait), file=sys.stderr)
        return 1

    try:
        os.execvp(CLIENT, argv)
    except OSError as error:
        print("windows-rdp: cannot run %s: %s" % (CLIENT, error), file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
